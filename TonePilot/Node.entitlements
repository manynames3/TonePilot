<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Applied only to the bundled Node.js runtime (Contents/Helpers/node), never to the app.
     V8 compiles JavaScript at run time; under the hardened runtime Node crashes on start
     without allow-jit. On Apple Silicon that alone covers JIT, WebAssembly and fetch, so
     allow-unsigned-executable-memory and the other entitlements Node.js ships with are not requested. -->
<plist version="1.0">
<dict>
    <key>com.apple.security.cs.allow-jit</key><true/>
</dict>
</plist>
